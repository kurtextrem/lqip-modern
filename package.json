{
  "name": "lqip-modern",
  "version": "2.2.1",
  "description": "Modern approach to Low Quality Image Placeholders (LQIP) using webp and sharp.",
  "repository": "transitive-bullshit/lqip-modern",
  "author": "Travis Fischer <travis@transitivebullsh.it>",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "type": "module",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    "types": "./index.d.ts",
    "default": "./index.js"
  },
  "sideEffects": false,
  "files": [
    "index.js",
    "index.d.ts"
  ],
  "scripts": {
    "test": "run-s test:*",
    "test:unit": "ava -v",
    "test:lint": "eslint .",
    "test:format": "prettier '**/*.{js,json,ts}' --check",
    "demo:generate": "node demo/generate-comparison-data.js",
    "demo": "node demo/server.js",
    "bench:preview": "node demo/server.js --bench-preview",
    "bench:generate-configs": "node demo/benchmarks/generate-configs.mjs",
    "bench:reflow": "pnpm bench:generate-configs && tachometer --config demo/benchmarks/tachometer-reflow.json --json-file demo/benchmarks/results/reflow-results.json --csv-file demo/benchmarks/results/reflow-stats.csv --csv-file-raw demo/benchmarks/results/reflow-raw.csv",
    "bench:animation": "pnpm bench:generate-configs && tachometer --config demo/benchmarks/tachometer-animation.json --json-file demo/benchmarks/results/animation-results.json --csv-file demo/benchmarks/results/animation-stats.csv --csv-file-raw demo/benchmarks/results/animation-raw.csv",
    "bench:reflow:server": "BENCH_BASE_URL=http://127.0.0.1:3000 pnpm bench:reflow",
    "bench:animation:server": "BENCH_BASE_URL=http://127.0.0.1:3000 pnpm bench:animation",
    "bench:analyze:reflow": "node demo/benchmarks/analyze-traces.mjs --trace-dir demo/benchmarks/results/reflow-traces --output demo/benchmarks/results/reflow-trace-summary.json",
    "bench:analyze:animation": "node demo/benchmarks/analyze-traces.mjs --trace-dir demo/benchmarks/results/animation-traces --output demo/benchmarks/results/animation-trace-summary.json",
    "deploy": "gh-pages -d demo"
  },
  "dependencies": {
    "@unpic/placeholder": "0.1.2",
    "blurhash": "^2.0.5",
    "blurhash-to-css": "^0.5.5",
    "colorthief": "^2.6.0",
    "cssgip": "^1.0.4",
    "node-fetch": "^3.3.2",
    "p-map": "^7.0.2",
    "sharp": "^0.34.5",
    "thumbhash": "^0.1.1"
  },
  "devDependencies": {
    "@fisch0920/eslint-config": "^1.4.0",
    "ava": "^6.2.0",
    "eslint": "^8.57.0",
    "fs-extra": "^9.1.0",
    "gh-pages": "^6.2.0",
    "globby": "^11.0.3",
    "npm-run-all2": "^7.0.0",
    "prettier": "^3.3.3",
    "serve": "^11.3.2",
    "tachometer": "^0.7.2",
    "update-markdown-jsdoc": "^1.0.11"
  },
  "ava": {
    "failFast": true,
    "snapshotDir": "./.snapshots"
  }
}
