{
  "$schema": "../../node_modules/tachometer/config.schema.json",
  "root": "../..",
  "sampleSize": 12,
  "timeout": 0,
  "autoSampleConditions": [
    "0%"
  ],
  "benchmarks": [
    {
      "name": "backdrop-filter-blur-10-cv-off",
      "url": "animation-benchmark.html?technique=backdrop-filter&blur=10&contentVisibility=off",
      "measurement": [
        {
          "mode": "expression",
          "name": "runtime-ms",
          "expression": "window.tachometerResult"
        },
        {
          "mode": "expression",
          "name": "fps",
          "expression": "window.__benchmarkFps"
        },
        {
          "mode": "expression",
          "name": "avg-frame-ms",
          "expression": "window.__benchmarkAvgFrameMs"
        }
      ],
      "browser": {
        "name": "chrome",
        "headless": true,
        "windowSize": {
          "width": 1440,
          "height": 900
        },
        "trace": {
          "logDir": "demo/benchmarks/results/animation-traces",
          "categories": [
            "blink",
            "blink.user_timing",
            "cc",
            "devtools.timeline",
            "disabled-by-default-devtools.timeline",
            "disabled-by-default-devtools.timeline.frame",
